# Copy to .env (npm run setup does this for you and fills in BETTER_AUTH_SECRET).

# Matches docker-compose.yml
DATABASE_URL=postgres://newity:newity@localhost:5433/newity

# Signs session cookies. 32+ random chars; setup generates one. Never commit the real value.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Password for the demo accounts created by `npm run db:seed-users` (local only).
DEMO_PASSWORD=newity-demo-2026
